{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ApiBaseUrl": "https://alahiaposapidemo.alahiapos.com",

  "Host": {
    "Port": 5045
  },

  "PrinterSettings": {
    "Factura": "2C-POS80-01-V6 Printer",
    "Lavador": "2C-POS80-01-V6 Printer"
  },

  "Update": {
    "Enabled": true,
    "ManifestUrl": "https://alahiaposapidemo.alahiapos.com/updates/printer/latest.json",
    "CheckIntervalHours": 6,
    "StartupDelaySeconds": 30,
    "ServiceName": "AlahiaPrinterApi"
  }
}
